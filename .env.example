# ==============================================================================
# Registro Elettronico - Environment Variables Configuration
# ==============================================================================

# Application environment (development | production | test)
NODE_ENV=development

# Backend API server port
PORT=4000

# Base URL for API service
API_URL=http://localhost:4000

# Base URL for Web frontend
WEB_URL=http://localhost:3000

# PostgreSQL 16 database connection string
DATABASE_URL=postgresql://registro:registro@localhost:5432/registro?schema=public

# Redis 7 connection string
REDIS_URL=redis://localhost:6379

# JWT authentication secrets & expiration
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=super_secret_jwt_access_key_minimum_32_chars_long
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_minimum_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# MinIO / S3 Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=registro-files
S3_REGION=us-east-1

# SMTP Email Configuration (Mailpit in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Registro Elettronico <noreply@registro.local>"

# ClamAV Antivirus Scanner
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Gotenberg PDF Generation Service
GOTENBERG_URL=http://localhost:3001

# Symmetric Encryption Key for AES-256-GCM (64 hex characters = 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Sentry Monitoring DSN (optional)
SENTRY_DSN=
